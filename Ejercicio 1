package tema3;

import java.util.Scanner;

public class SimuladorAhorroMensual {
    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);
        final double INTERES = 0.01; // 1% mensual
        String repetir;

        do {
            System.out.print("Cantidad inicial: ");
            double inicial = scanner.nextDouble();
            while (inicial <= 0) {
                System.out.print("Debe ser positiva. Cantidad inicial: ");
                inicial = scanner.nextDouble();
            }
            System.out.print("Meta de ahorro: ");
            double meta = scanner.nextDouble();
            while (meta <= 0) {
                System.out.print("Debe ser positiva. Meta de ahorro: ");
                meta = scanner.nextDouble();
            }

            System.out.print("Ahorro mensual fijo: ");
            double mensual = scanner.nextDouble();
            while (mensual <= 0) {
                System.out.print("Debe ser positivo. Ahorro mensual: ");
                mensual = scanner.nextDouble();
            }

            // Plazo con switch
            System.out.println("Plazo: 1) 6 meses  2) 12 meses  3) 24 meses");
            System.out.print("Opcion: ");
            int opcion = scanner.nextInt();
            int plazo;
            switch (opcion) {
                case 1:
                    plazo = 6;
                    break;
                case 2:
                    plazo = 12;
                    break;
                case 3:
                    plazo = 24;
                    break;
                default:
                    System.out.println("Opcion invalida, se usara 6 meses.");
                    plazo = 6;
            }
            double saldo = inicial;
            double totalIntereses = 0;
            int mesesMeta = 0; // 0 = aun no se alcanza
            for (int mes = 1; mes <= plazo; mes++) {
                saldo += mensual;
                double interesMes = saldo * INTERES;
                saldo += interesMes;
                totalIntereses += interesMes;
                if (saldo >= meta && mesesMeta == 0) {
                    mesesMeta = mes;
                }
            }
            System.out.println("\n  Resultados ");
            System.out.printf("Saldo final: $%.2f%n", saldo);
            System.out.printf("Intereses generados: $%.2f%n", totalIntereses);
            if (mesesMeta > 0) {
                System.out.println("Meta alcanzada en el mes " + mesesMeta);
            } else {
                System.out.println("La meta NO se alcanzo en " + plazo + " meses.");
            }
            System.out.print("\nOtra simulacion? (si/no): ");
            repetir = scanner.next();
        } while (repetir.equalsIgnoreCase("si"));
    }
}
